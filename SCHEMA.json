{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLMResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "confidence", "entities", "missing_fields", "assistant_message"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "create_order",
        "modify_order",
        "confirm_order",
        "cancel_order",
        "ask_catalog",
        "ask_price",
        "ask_status",
        "provide_customer_data",
        "provide_delivery_address",
        "opt_in_suggestions",
        "opt_out_suggestions",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "entities": {
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "requested_datetime": { "type": ["string", "null"] },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["item_name", "qty"],
                "properties": {
                  "item_name": { "type": "string" },
                  "qty": { "type": "number" },
                  "uom": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "delivery": {
          "type": "object",
          "properties": {
            "use_default": { "type": ["boolean", "null"] },
            "alias": { "type": ["string", "null"] }
          }
        },
        "consent": {
          "type": "object",
          "properties": {
            "suggestions": {
              "type": ["string", "null"],
              "enum": ["opt_in", "opt_out", null]
            }
          }
        }
      }
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "assistant_message": {
      "type": "string"
    }
  }
}
